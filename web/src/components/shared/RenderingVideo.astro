---
/**
 * One honest proof asset, reused on the home page and the dedicated showcase.
 * The browser recording is deliberately click-to-play: the Paper direction's
 * only ambient motion remains the caret, and reduced-motion users never have
 * to race an autoplaying clip.
 */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={["rendering-proof", { compact }]}>
  <div class="recording">
    <video
      controls
      muted
      loop
      playsinline
      preload="metadata"
      poster="/media/terminaltui-kitty-video-poster.jpg"
      width="1920"
      height="1132"
      aria-label="Cinema demo playing Sintel as real pixels inside the Kitty terminal"
    >
      <source src="/media/terminaltui-kitty-video.mp4" type="video/mp4" />
      <a href="/media/terminaltui-kitty-video.mp4">Download the 3-second MP4 recording.</a>
    </video>
    <span class="proof-tag pixel-eyebrow">Real Kitty capture · 24 frames</span>
  </div>
  <figcaption>
    Cinema running in Kitty on macOS. The moving image is rendered through Kitty's
    graphics protocol; terminaltui owns the page, transport, navigation and layout.
    The same block falls back to coloured cells on other terminals. Recording: 3 seconds,
    1920×1132, silent. Sintel © Blender Foundation, CC-BY 3.0.
  </figcaption>
</figure>

<style>
  .rendering-proof { margin: 2.5rem 0 0; }
  .recording {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: #09090a;
  }
  video {
    width: 100%;
    aspect-ratio: 864 / 509;
    object-fit: contain;
    background: #09090a;
  }
  .proof-tag {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.55rem 0.7rem;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    pointer-events: none;
  }
  figcaption {
    max-width: 74ch;
    margin-top: 0.85rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .compact { margin-top: 2rem; }
  .compact figcaption { max-width: 66ch; }

  @media (max-width: 36rem) {
    .proof-tag {
      position: static;
      display: block;
      border: 0;
      border-top: 1px solid var(--color-line);
      background: var(--color-bg);
    }
  }
</style>
