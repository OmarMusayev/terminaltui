---
/**
 * One tiling variant, shown as a specimen rather than a product shot: the mark
 * at working size, the four sizes it has to survive, then the argument for it,
 * the argument against it, and the measured geometry.
 *
 * The geometry line is deliberately last and deliberately monospaced. It is the
 * part that is checkable, and putting it under the prose means the prose can be
 * argued with.
 */
import PixelMark from "@/components/shared/PixelMark.astro";

interface CriticScore {
  id: string;
  escapes: number;
  legible16: number;
  silhouette: number;
  authored: number;
  score: number;
  verdict: string;
  claimError?: string;
}

interface Props {
  id: string;
  title: string;
  grid: readonly string[];
  thesis?: string;
  at16?: string;
  risk?: string;
  geometry?: string;
  mean?: number;
  rank?: number;
  scores?: Record<string, CriticScore>;
}
const { id, title, grid, thesis, at16, risk, geometry, mean, rank, scores } = Astro.props;

const LENS_LABEL: Record<string, string> = { brand: "Brand", pixel: "Pixel", user: "Dev" };
const lenses = scores ? Object.entries(scores) : [];

/**
 * Claim checks: where a critic caught the author's own stated geometry out.
 *
 * When several critics catch the same thing they say it three different ways,
 * and printing all three reads as a rendering fault rather than as three
 * independent confirmations. Print the most specific one, attributed, and name
 * the others as corroboration.
 */
const raised = lenses
  .map(([k, s]) => (s.claimError ? { lens: k, text: s.claimError } : null))
  .filter(Boolean) as { lens: string; text: string }[];
const claim = raised.length
  ? {
      ...[...raised].sort((a, b) => b.text.length - a.text.length)[0],
      also: raised.length - 1,
      lenses: raised.map((r) => LENS_LABEL[r.lens] ?? r.lens),
    }
  : null;
---

<figure class="tk" id={id}>
  <div class="tk-big">
    <PixelMark grid={grid} size={112} title={title} />
  </div>

  <div class="tk-sizes" aria-label="Rendered at 16, 24, 32 and 48 pixels">
    {[16, 24, 32, 48].map((s) => (
      <span class="tk-s">
        <PixelMark grid={grid} size={s} />
        <em class="tk-px">{s}</em>
      </span>
    ))}
  </div>

  <figcaption class="tk-cap">
    <p class="tk-id">
      <code>{id}</code>
      {rank !== undefined && <span class:list={["tk-rank", rank <= 3 && "tk-rank-top"]}>#{rank}</span>}
      {mean !== undefined && <span class="tk-mean tnum">{mean.toFixed(1)}</span>}
    </p>
    <p class="tk-title">{title}</p>

    {thesis && <p class="tk-txt">{thesis}</p>}
    {at16 && <p class="tk-txt"><b>At 16px:</b> {at16}</p>}
    {risk && <p class="tk-txt"><b>Risk:</b> {risk}</p>}

    {claim && (
      <p class="tk-txt tk-err">
        <b>Claim checked{claim.also ? ` — all ${claim.lenses.length} critics` : ` — ${LENS_LABEL[claim.lens] ?? claim.lens}`}:</b>{" "}
        {claim.text}
      </p>
    )}

    {lenses.length > 0 && (
      <dl class="tk-scores">
        {lenses.map(([k, s]) => (
          <div class="tk-score">
            <dt>{LENS_LABEL[k] ?? k}</dt>
            <dd class="tnum">{s.score.toFixed(1)}</dd>
          </div>
        ))}
      </dl>
    )}

    {geometry && <p class="tk-geo">{geometry}</p>}
  </figcaption>
</figure>

<style>
  .tk {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    min-width: 0;
    scroll-margin-top: 4rem;
  }
  .tk:target { border-color: var(--color-accent); }

  .tk-big {
    display: grid;
    place-items: center;
    padding: 2rem 1rem 1.5rem;
    color: var(--color-ink);
  }
  .tk-sizes {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1.125rem;
    padding: 0 1rem 1.125rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .tk-s { display: grid; justify-items: center; gap: 0.375rem; }
  .tk-px {
    font-family: var(--font-display);
    font-size: 10px;
    font-style: normal;
    color: var(--color-muted);
  }

  .tk-cap { padding: 0.875rem 1.125rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .tk-id {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tk-id code { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink); }
  .tk-rank,
  .tk-mean {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    padding: 0.15rem 0.35rem;
  }
  /* Accent means "look here". A rank badge earns it in the top three and
     nowhere else; #25 in signal colour is just noise. */
  .tk-rank-top { color: var(--color-accent); border-color: var(--color-accent); }

  .tk-title {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tk-txt {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .tk-txt b { color: var(--color-ink); font-weight: 500; }
  .tk-err b { color: var(--color-accent); }

  .tk-scores {
    display: flex;
    gap: 0;
    margin: 0.875rem 0 0;
    border: 1px solid var(--color-line);
  }
  .tk-score {
    flex: 1;
    display: grid;
    gap: 0.1rem;
    padding: 0.4rem 0.5rem;
    min-width: 0;
  }
  .tk-score + .tk-score { border-left: 1px solid var(--color-line); }
  .tk-score dt {
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tk-score dd { margin: 0; font-size: 0.8125rem; color: var(--color-ink); }

  .tk-geo {
    margin: 0.75rem 0 0;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--color-muted);
    overflow-wrap: anywhere;
    margin-top: auto;
  }
</style>
