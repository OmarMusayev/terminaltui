---
/**
 * The demo gallery — every real capture we have, at a size you can read.
 *
 * This is the page the frames asset was made for: the apps with captured frames
 * package, each shown as genuine output with the command that runs it.
 */
import Shell from "@/layouts/Shell.astro";
import TerminalFrame from "@/components/shared/TerminalFrame.astro";
import CopyCommand from "@/components/shared/CopyCommand.astro";
import StarButton from "@/components/shared/StarButton.astro";
import { DIRECTION_KEYS, getDirection, baseFor, url } from "@/lib/site";
import { demos, themes } from "@/data/product";
import { getFrames } from "@/lib/frames";

interface Props {
  dir?: string;
  base?: string;
}

export async function getStaticPaths() {
  return DIRECTION_KEYS.map((dir) => ({ params: { dir } }));
}

const routeDir = Astro.props.dir ?? Astro.params.dir ?? "paper";
const direction = getDirection(routeDir);
const base = Astro.props.base ?? baseFor(routeDir);

const swatchFor = (name: string) => themes.find((t) => t.name === name)?.swatch ?? [];

const gallery = demos
  .map((d) => ({ ...d, frames: getFrames(d.key) }))
  .filter((d) => d.frames.length > 0);

const totalFrames = gallery.reduce((n, d) => n + d.frames.length, 0);
---

<Shell
  dir={direction.key}
  base={base}
  active="Demos"
  defaultTheme={direction.defaultTheme}
  title="Demos — terminaltui"
  description={`${gallery.length} interactive terminal apps that ship in the package, shown as ${totalFrames} real screen captures. Run any of them with a single npx command.`}
  path={url(base, "demos/")}
>
  <div class="wrap dm">
    <header class="dm-head">
      <p class="pixel-eyebrow dm-eyebrow">Demos</p>
      <h1 class="dm-title pixel">{gallery.length} apps, one command each</h1>
      <p class="dm-lede">
        Every demo below ships inside the package. Nothing here is a mock-up: each
        screen was captured by booting the demo inside terminaltui's own headless
        terminal emulator and dumping the coloured cell grid straight to HTML.
      </p>
    </header>

    {gallery.map((d, i) => (
      <section class="dm-demo" aria-labelledby={`d-${d.key}`}>
        <div class="dm-meta">
          <p class="dm-n pixel-eyebrow">{String(i + 1).padStart(2, "0")}</p>
          <h2 id={`d-${d.key}`} class="dm-name">{d.label}</h2>
          <p class="dm-theme">
            <span class="dm-swatch" aria-hidden="true">
              {swatchFor(d.theme).map((c) => <i style={`background:${c}`}></i>)}
            </span>
            <span class="dm-theme-name">{d.theme}</span>
          </p>
          <CopyCommand cmd={d.cmd} class="dm-cmd" />
          <p class="dm-count tnum">
            {d.frames.length} screen{d.frames.length === 1 ? "" : "s"} captured
          </p>
        </div>

        <div class="dm-frames">
          {d.frames.map((f) => (
            <TerminalFrame
              demo={d.key}
              label={f.label}
              caption={`${d.key}/${f.label} · ${f.cols}x${f.rows} cells`}
            />
          ))}
        </div>
      </section>
    ))}

    <footer class="dm-foot">
      <h2 class="dm-foot-h pixel">Build one of your own</h2>
      <p class="dm-foot-p">
        Every demo here is a directory of TypeScript files. Scaffold the same shape with
        <code>terminaltui init</code>, or read one of theirs — they ship in the package.
      </p>
      <div class="dm-foot-cta">
        <CopyCommand cmd="npx terminaltui init my-app" />
        <StarButton size="md" />
      </div>
    </footer>
  </div>
</Shell>

<style>
  .dm { --wrap: 78rem; padding-block: clamp(3rem, 7vw, 5rem) 2rem; }

  .dm-eyebrow { color: var(--color-accent); margin: 0 0 1rem; }
  .dm-title { font-size: clamp(1.75rem, 5vw, var(--px-lg)); margin: 0; line-height: 1.15; }
  .dm-lede {
    margin: 1.25rem 0 0;
    max-width: 58ch;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .dm-head { padding-bottom: 2.5rem; border-bottom: 1px solid var(--color-line); }

  .dm-demo {
    display: grid;
    /* minmax(0,...) not 1fr: a bare 1fr is minmax(auto,1fr), whose auto floor is
       the content's min-content width — a long npx command then widens the track
       past the viewport and the whole page scrolls sideways. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-line);
  }
  .dm-meta { min-width: 0; }
  @media (min-width: 60rem) {
    .dm-demo { grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; }
    .dm-meta { position: sticky; top: 6rem; align-self: start; }
  }

  .dm-n { color: var(--color-accent); margin: 0 0 0.5rem; }
  .dm-name { font-size: 1.25rem; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  .dm-theme { display: flex; align-items: center; gap: 0.5rem; margin: 0.75rem 0 1rem; }
  .dm-swatch { display: inline-flex; gap: 2px; }
  .dm-swatch i { width: 10px; height: 10px; display: block; }
  .dm-theme-name { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); }
  .dm-cmd { font-size: 0.8125rem; }
  .dm-count { margin: 0.75rem 0 0; font-size: 0.8125rem; color: var(--color-muted); }

  .dm-frames { display: grid; gap: 1.5rem; min-width: 0; }

  .dm-foot { padding-block: 3.5rem; }
  .dm-foot-h { font-size: var(--px-md); margin: 0 0 0.875rem; }
  .dm-foot-p { margin: 0 0 1.5rem; max-width: 52ch; color: var(--color-muted); line-height: 1.6; }
  .dm-foot-p code { font-family: var(--font-mono); font-size: 0.9em; color: var(--color-ink); }
  .dm-foot-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
</style>
